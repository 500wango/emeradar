# Emeradar Environment Variables
#
# TEMPLATE, not a config file. Copy this to `.env` only when setting up a NEW
# deployment, then fill in real values.
#
# On the production host /opt/emeradar/.env already exists and holds the live
# secrets. `cp .env.example .env` there initialises nothing: it blanks the
# database password, the auth secret and every API key, and the next deploy
# fails on `docker compose config`. Copy the existing file, never the template:
#   cp -p .env .env.$(date +%F).bak
#
# If it is already clobbered, the values are still readable from containers that
# were created before the mistake: docker inspect <name> --format '{{.Config.Env}}'.
#
# Production Docker: generate two independent values with openssl rand -hex 32.
# Required for first initialization; changing these does not rotate an existing DB password.
POSTGRES_PASSWORD=""
EMERADAR_DB_PASSWORD=""
# Local development only; Docker Compose builds DATABASE_URL from EMERADAR_DB_PASSWORD.
DATABASE_URL="postgres://michael:postgres@localhost:5432/emeradar"
# Direct connection for the job queue (apps/worker, pg-boss) and session-level locks.
# Leave empty unless a transaction-mode pooler (PgBouncer) sits in front of the database:
# an empty value falls back to DATABASE_URL. See ADR-003 / ADR-012.
DATABASE_DIRECT_URL=""
# Recipients for background-job failure alerts (comma separated). When empty, the
# worker falls back to the emails of active ADMIN accounts.
OPS_ALERT_EMAIL=""
NODE_ENV="development"
PORT="3000"

# Base origin used to build absolute links (verification / password reset). Production: https://emeradar.com
APP_ORIGIN="https://emeradar.com"

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google Search Console OAuth. GSC_TOKEN_ENCRYPTION_KEY is REQUIRED in production:
# without it the GSC feature fails closed and returns 503. Use a 32-byte hex value
# (openssl rand -hex 32) and keep it stable; rotating it invalidates stored tokens.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GSC_REDIRECT_URI=""
GSC_TOKEN_ENCRYPTION_KEY=""

# Discovery pipeline tuning. DISCOVERY_RSS_FEEDS is a comma-separated list of RSS URLs.
# DISCOVERY_VALIDATION_BUDGET_USD caps daily discovery validation spend (0 = no spend).
DISCOVERY_RSS_FEEDS=""
DISCOVERY_VALIDATION_BUDGET_USD=""

# Production public URL and optional collector / notification credentials.
NEXT_PUBLIC_SITE_URL="https://emeradar.com"
SERP_API_KEY=""
BRAVE_API_KEY=""
AISA_API_KEY=""
AISA_SEARCH_URL="https://api.aisa.one/apis/v1/tavily/search"
BROWSERLESS_API_KEY=""

# 邮件投递（邮箱验证 / 找回密码 / 后台任务告警）。唯一发送器是
# packages/services/src/email.service.ts，通道按顺序选择：SMTP 优先，其次 Resend。
# 两个都没配时发送返回 false 并只写日志 —— 业务流程照常走完，但确实没有信出去。
# SMTP（自建 Stalwart，或任何 SMTP 服务商）。465 = 隐式 TLS，587 = STARTTLS；
# SMTP_PORT 留空按 465 处理。填了 SMTP_USER 就必须有 SMTP_PASSWORD：带凭据的
# 连接强制加密（465 隐式 TLS，其余端口强制 STARTTLS），不会退回明文。
SMTP_HOST=""
SMTP_PORT="465"
# 只有服务端不按端口约定加密时才需要显式写 true/false。
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASSWORD=""
# 发信人地址，必须属于已配好 SPF/DKIM 的域：否则会被 SPF/DMARC 判失败。
MAIL_FROM=""
# 可选兜底通道；配了 SMTP_HOST 就不会用它。Resend 认 Idempotency-Key，
# SMTP 没有这个能力，只能靠确定的 Message-ID 让收件方去重（见 email.service.ts）。
RESEND_API_KEY=""
# 旧名字：MAIL_FROM 未设置时才用它。
ALERT_FROM_EMAIL=""
