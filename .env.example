# Emeradar Environment Variables
# Production Docker: generate two independent values with openssl rand -hex 32.
# Required for first initialization; changing these does not rotate an existing DB password.
POSTGRES_PASSWORD=""
EMERADAR_DB_PASSWORD=""
# Local development only; Docker Compose builds DATABASE_URL from EMERADAR_DB_PASSWORD.
DATABASE_URL="postgres://michael:postgres@localhost:5432/emeradar"
NODE_ENV="development"
PORT="3000"

NEXTAUTH_URL="https://emeradar.com"
NEXTAUTH_SECRET=""

OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Production public URL and optional collector / notification credentials.
NEXT_PUBLIC_SITE_URL="https://emeradar.com"
SERP_API_KEY=""
BRAVE_API_KEY=""
BROWSERLESS_API_KEY=""
RESEND_API_KEY=""
ALERT_FROM_EMAIL=""
