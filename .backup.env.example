# Configuration for scripts/backup-to-r2.sh (off-site PostgreSQL backup).
#
# Setup:
#   cp .backup.env.example /opt/emeradar/.backup.env
#   chmod 600 /opt/emeradar/.backup.env      # must stay root-only: it holds the
#                                            # R2 secret and the backup passphrase
# Then run `scripts/backup-to-r2.sh` once by hand before adding the cron entry.
#
# This file is read only by the backup script. It is deliberately separate from
# .env: the app .env is consumed by the containers and sourced by nothing, and
# mixing the two would put the storage credentials inside the application.

# --- Cloudflare R2 -----------------------------------------------------------
# Account ID: Cloudflare dashboard -> R2 -> the ID shown in the sidebar.
R2_ACCOUNT_ID=""
# An R2 API token (R2 -> Manage API Tokens). R2 tokens have no write-only mode,
# so this token can also read and delete objects; keep it out of git and rotate
# it if it ever leaks.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket name, e.g. emeradar-backups.
R2_BUCKET=""
# Key prefix inside the bucket. Keep the trailing slash.
R2_KEY_PREFIX="daily/"

# --- Encryption --------------------------------------------------------------
# Passphrase for the client-side GPG envelope. Generate with:
#   openssl rand -base64 32
# Store it in your password manager. Without it the off-site archives are
# unrecoverable — this is the only copy that matters.
BACKUP_GPG_PASSPHRASE=""

# --- Local retention ---------------------------------------------------------
# Days to keep the encrypted bundle under /opt/emeradar-backups on the VPS.
# Overrides the script default of 7. The R2 side is expired by a bucket
# lifecycle rule instead (see docs/21-DOCKER-VPS-DEPLOYMENT.md).
# LOCAL_KEEP_DAYS="7"

# --- Failure alerts (optional) ------------------------------------------------
# If all three are set, the script emails when a backup fails. Leave blank to
# disable; the exit code and /var/log/emeradar-backup.log still record every run.
BACKUP_ALERT_TO=""
ALERT_FROM_EMAIL=""
RESEND_API_KEY=""
# Set to 1 to also get a mail after every successful run. Off by default: a
# daily "all good" mail is how you end up ignoring the failure one.
# BACKUP_ALERT_ON_SUCCESS="0"
