FROM node:22-bookworm-slim
ENV PNPM_HOME=/pnpm
# Corepack installs the pinned package manager into COREPACK_HOME. Pointing it
# inside PNPM_HOME (which we hand to the runtime user) keeps the container from
# re-downloading pnpm from the registry on every cold start — a failed download
# would otherwise take down the scheduled worker.
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@11.21.0 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json ./
COPY apps ./apps
COPY packages ./packages
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @emeradar/worker build
# Drop privileges for the runtime process. The base image ships a `node` user.
# PNPM_HOME/COREPACK_HOME must belong to that user too: corepack writes its
# version cache there, and the pnpm shim lives on PATH.
# TODO: a multi-stage build (and dropping the tsx runtime dependency) is a
# separate, higher-risk refactor: workspace packages currently export TS source
# and the runtime executes TS via tsx, so it is intentionally not changed here.
RUN chown -R node:node /app /pnpm
USER node
ENTRYPOINT ["pnpm", "--filter", "@emeradar/worker"]
CMD ["run-daily"]
